{
  "name": "@rodkisten/uai",
  "private": true,
  "scripts": {
    "build": "shadcn build --output public/r && vite build && node scripts/verify-registry.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "smoke:hosting": "node scripts/smoke-hosting.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "sync:plan": "node scripts/sync-plan.mjs",
    "sync:install": "node scripts/sync-install.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "test:utils": "node --test packages/tests/*.test.mjs"
  },
  "devDependencies": {
    "shadcn": "latest",
    "vite": "latest",
    "typescript": "~6.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.6.2",
    "eslint": "^10.0.0",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "^8.46.0",
    "globals": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "latest",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "codemirror": "latest",
    "@codemirror/autocomplete": "latest",
    "@codemirror/view": "latest",
    "@codemirror/state": "latest",
    "@codemirror/lang-yaml": "latest",
    "@codemirror/theme-one-dark": "latest",
    "@radix-ui/react-tabs": "latest",
    "@codemirror/lang-javascript": "latest",
    "@tanstack/react-router": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-dialog": "latest"
  },
  "version": "0.1.0",
  "exports": {
    "./logger": {
      "types": "./packages/logger/index.d.mts",
      "import": "./packages/logger/index.mjs",
      "default": "./packages/logger/index.mjs"
    },
    "./summary": {
      "types": "./packages/summary/index.d.mts",
      "import": "./packages/summary/index.mjs",
      "default": "./packages/summary/index.mjs"
    },
    "./ci": {
      "types": "./packages/ci-utils/index.d.mts",
      "import": "./packages/ci-utils/index.mjs",
      "default": "./packages/ci-utils/index.mjs"
    }
  },
  "files": [
    "packages/logger",
    "packages/summary",
    "packages/ci-utils"
  ]
}
